# ─── Root .env for docker-compose ────────────────────────────────────────────
# Copy to .env and fill in real values before running docker compose

# Database password (shared by postgres service and backend)
DB_PASSWORD=your_secure_db_password_here

# Security keys — must be strong random strings in production
JWT_SECRET=replace_with_minimum_32_char_random_string
ENCRYPTION_KEY=replace_with_exactly_32_char_key!!

# SMTP (leave empty to use Ethereal simulation)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@appointmentbooking.co.za
EMAIL_FROM_NAME=Appointment Booking System
